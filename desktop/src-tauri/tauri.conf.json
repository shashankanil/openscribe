{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenScribe",
  "version": "0.5.0",
  "identifier": "org.open-source.openscribe",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenScribe",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 650,
        "center": true,
        "decorations": true
      },
      {
        "label": "flowbar",
        "title": "OpenScribe Flowbar",
        "url": "flowbar.html",
        "width": 260,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "meeting-notes",
        "title": "Meeting notes",
        "url": "meeting-notes.html",
        "width": 420,
        "height": 480,
        "minWidth": 300,
        "minHeight": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/Attachments/**", "$APPDATA/Meetings/**"] },
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "category": "Productivity",
    "shortDescription": "Private, provider-powered dictation and meeting notes",
    "longDescription": "OpenScribe records dictation and meetings, transcribes with your chosen provider, and keeps a searchable local note library."
  }
}
