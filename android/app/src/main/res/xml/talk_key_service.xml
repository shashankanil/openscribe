<?xml version="1.0" encoding="utf-8"?>
<!-- Watches key presses (for the chosen talk button) and the moment of a copy (taps on a "Copy" button, the system's
     copied preview) so copies can go to the Mac. It never reads window content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeWindowStateChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/talk_key_service_description"
    android:summary="@string/talk_key_service_summary" />
