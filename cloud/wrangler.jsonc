/**
 * OpenScribe Cloud: sync API + remote MCP server on Cloudflare Workers.
 * See README.md for deploy steps. Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
 * COOKIE_ENCRYPTION_KEY, optional HOSTED_DOMAIN) are set with `wrangler secret put`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openscribe-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // Public origin of this Worker, no trailing slash. MCP tokens are bound to
    // `${PUBLIC_URL}/mcp`, so set this to the deployed URL before `wrangler deploy`.
    "PUBLIC_URL": "https://openscribe-cloud.shashankmay6.workers.dev",
    // Linked from the landing page.
    "APP_DOWNLOAD_URL": "https://github.com/shashankanil/openscribe/releases/latest",
    // Per-user storage cap for screenshots and recordings in R2 (5 GB).
    "MEDIA_QUOTA_BYTES": "5368709120"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openscribe",
      "database_id": "cbca0e95-5622-48bb-b60e-d6e344301515",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // OAuth grants/tokens/clients (workers-oauth-provider) and short-lived login state.
      "binding": "OAUTH_KV",
      "id": "434204c7a50141c980f0384f847a5a70"
    }
  ],
  "r2_buckets": [
    {
      // Screenshots and meeting recordings, keyed u/{userId}/{documentId}/{attachmentId}.
      // Also Phone Link clipboard images at link/{userId}/{blobId} (2-day lifecycle rule, see README).
      "binding": "MEDIA",
      "bucket_name": "openscribe-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        // Phone Link relay: one object per `${userId}:${room}`, holding at most one mac and one phone socket.
        "name": "LINK_RELAY",
        "class_name": "LinkRelay"
      }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LinkRelay"] }],
  "observability": { "enabled": true },
  "dev": { "port": 8788 }
}
